# This file ensures the data/ directory is tracked by git even though
# raw_urls.csv and features.csv (generated by collector.py / trainer.py)
# are excluded via .gitignore.
#
# sample_urls.csv IS committed — it lets anyone clone this repo and run
# `python trainer.py --raw data/sample_urls.csv` immediately, without
# needing API keys or live feed access first.
