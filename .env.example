# .env.example — Copy this file to .env and fill in your real API keys.
# .env is gitignored and will NEVER be committed — config.py reads from it
# automatically if present (falls back to the placeholder values in
# config.py if .env is missing, so the project still runs without any keys).

# PhishTank — free key: https://www.phishtank.com/api_info.php
PHISHTANK_API_KEY=

# WhoisXML API — free 500 lookups/month: https://www.whoisxmlapi.com
WHOIS_API_KEY=

# Google Safe Browsing — free: https://console.cloud.google.com
# (search "Safe Browsing API" → Enable → Credentials → Create API Key)
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal — free 500 lookups/day: https://www.virustotal.com/gui/sign-in
VIRUSTOTAL_API_KEY=
